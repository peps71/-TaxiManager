{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(firebase *)",
      "Bash(npx firebase *)",
      "Bash(npx firebase-tools *)",
      "Bash(gcloud *)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(playwright install *)",
      "Bash(npx playwright install *)"
    ]
  }
}
